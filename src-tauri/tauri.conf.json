{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSA Channels",
  "version": "1.1.0",
  "identifier": "com.jsadjsteam.channels",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "JSA DJ's Team",
    "category": "Music",
    "shortDescription": "JSA Channels",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
